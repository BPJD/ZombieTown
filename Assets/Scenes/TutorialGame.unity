--- !u!114 &1288918775
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1288918773}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18f2de1450b9d684e836da0f3c9b684b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialText:
  - "\uD29C\uD1A0\uB9AC\uC5BC\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4!\n\uC774
    \uAC8C\uC784\uC740 \uBAB0\uB824\uC624\uB294 \uC880\uBE44\uB97C \uBB3C\uB9AC\uCE58\uACE0,
    \uC790\uC6D0\uC744 \uBAA8\uC544 7\uC77C \uB3D9\uC548 \uC0B4\uC544\uB0A8\uB294
    \uAC83\uC774 \uBAA9\uD45C\uC785\uB2C8\uB2E4."
  - "\uC774\uB3D9 \uD328\uB4DC\uB97C \uC870\uC791\uD558\uC5EC \uB9F5\uC744 \uB3CC\uC544\uB2E4\uB2C8\uACE0,
    \uC880\uBE44\uC640 \uC804\uD22C\uB97C \uD574\uBCF4\uC138\uC694."
  - "\uC798 \uD558\uC168\uC2B5\uB2C8\uB2E4.\r\n\uC0AC\uAC70\uB9AC\uC5D0 \uC880\uBE44\uAC00
    \uC788\uC73C\uBA74 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC880\uBE44\uB97C \uC790\uB3D9\uC73C\uB85C
    \uACF5\uACA9\uD569\uB2C8\uB2E4.\r\n\uC880\uBE44\uB294 \uB0AE \uC2DC\uAC04\uC77C
    \uB550 \uD06C\uAC8C \uC704\uD611\uC801\uC774\uC9C0 \uC54A\uC9C0\uB9CC, \uBC24\uC774
    \uB418\uBA74 \uB2F9\uC2E0\uC744 \uC8FD\uC774\uAE30 \uC704\uD574\r\n\uB354 \uB9CE\uC740
    \uC218\uC758 \uC880\uBE44\uAC00 \uB2F9\uC2E0\uC744 \uD5A5\uD574 \uC804\uC18D\uB825\uC73C\uB85C
    \uB2EC\uB824\uB4E4 \uAC83\uC785\uB2C8\uB2E4."
  - "\uC774\uC81C \uC790\uC6D0\uC5D0 \uB300\uD574 \uC54C\uC544\uBCF4\uACA0\uC2B5\uB2C8\uB2E4.\n\uC790\uC6D0\uC740
    \uAC74\uBB3C\uC5D0\uC11C \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAC74\uBB3C\uC5D0
    \uC811\uADFC\uD558\uBA74 \uB098\uC624\uB294 [\uC785\uC7A5] \uBC84\uD2BC\uC744
    \uB20C\uB7EC \uAC74\uBB3C\uC5D0 \uB4E4\uC5B4\uAC00\uBCF4\uC138\uC694."
  - "\uAC74\uBB3C\uC5D0 \uC785\uC7A5\uD558\uBA74 \uC880\uBE44\uAC00 \uB9CE\uC774
    \uBD99\uB354\uB77C\uB3C4 \uB2F9\uC2E0\uC740 \"\uC77C\uB2E8\" \uC548\uC804\uD569\uB2C8\uB2E4.\r\n\uC880\uBE44\uB294
    \uB2F9\uC2E0\uC774 \uC788\uB294 \uAC74\uBB3C\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4.
    \uB9CC\uC57D \uAC74\uBB3C\uC774 \uBB34\uB108\uC9C0\uBA74, \uB2F9\uC2E0\uC740
    \uC8FD\uC74C\uC744 \uD53C\uD560 \uC218 \uC5C6\uB294 \uD53C\uD574\uB97C \uC785\uC2B5\uB2C8\uB2E4.\r\n\uC774\uC81C
    \uAC74\uBB3C\uC744 \uC870\uC0AC\uD574\uBD05\uC2DC\uB2E4."
  - "\uC790\uC6D0\uC740 \uD06C\uAC8C \uC138 \uAC00\uC9C0\uB85C \uB098\uB269\uB2C8\uB2E4.\n\uC2DD\uB7C9
    : \uC77C\uC815 \uC2DC\uAC04\uB9C8\uB2E4 \uAC10\uC18C\uD558\uACE0, \uC2DD\uB7C9\uC774
    \uC5C6\uC73C\uBA74 \uB2F9\uC2E0\uC758 \uCCB4\uB825\uC774 \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\uBD80\uD488
    : \uAC74\uBB3C \uC218\uB9AC, \uBB34\uAE30 \uC81C\uC791 \uB4F1 \uC5C5\uADF8\uB808\uC774\uB4DC\uC5D0
    \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\r\n\uD0C4\uC57D : \uBB34\uAE30\uB85C \uC801\uC744
    \uCC98\uCE58\uD560 \uB54C \uC18C\uBAA8\uB429\uB2C8\uB2E4. \uAD8C\uCD1D\uC740
    \uD0C4\uC57D\uC744 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC9C0\uB9CC, \uAC15\uD55C
    \uBB34\uAE30\uB97C \uC0AC\uC6A9\uD560\uC218\uB85D \uB354 \uB9CE\uC740 \uD0C4\uC57D\uC774
    \uD544\uC694\uD569\uB2C8\uB2E4."
  - "\uB2F9\uC2E0\uC774 \uC5B4\uB5A4 \uD589\uB3D9\uC744 \uD558\uB294 \uB3D9\uC548\uC5D0\uB294
    \uACF5\uACA9\uC744 \uD558\uC9C0 \uC54A\uB294\uB2E4\uB294 \uC810 \uBA85\uC2EC\uD558\uC138\uC694.\r\n\uD654\uBA74
    \uC624\uB978\uCABD \uD558\uB2E8\uC5D0 + \uBAA8\uC591\uC744 \uB204\uB974\uBA74
    \uC5C5\uADF8\uB808\uC774\uB4DC \uCC3D\uC744 \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uBD80\uD488
    \uC790\uC6D0\uC744 \uC9C0\uAE09\uD588\uC2B5\uB2C8\uB2E4. \"\uAE30\uAD00\uB2E8\uCD1D\"
    \uBB34\uAE30\uB97C \uC81C\uC791\uD574\uBCF4\uC138\uC694."
  - "\uACE7 \uD574\uAC00 \uC9C0\uACE0, \uBC24\uC774 \uB429\uB2C8\uB2E4.\r\n\uBC24\uC774
    \uB418\uAE30 \uC804\uC5D0 \uAC74\uBB3C\uC744 \uC218\uB9AC\uD558\uACE0, \uBC14\uAE65\uC5D0
    \uB098\uAC00\uC9C0 \uC54A\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
  - "\uC55E\uC11C \uB9D0\uC500\uB4DC\uB838\uB4EF\uC774, \uBC24\uC774 \uB418\uBA74
    \uC880\uBE44\uC758 \uC218\uC640 \uC774\uB3D9\uC18D\uB3C4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n\uCDA9\uBD84\uD55C
    \uC591\uC758 \uD0C4\uC57D\uC744 \uBBF8\uB9AC \uC900\uBE44\uD558\uACE0, \uAC74\uBB3C\uC744
    \uC218\uB9AC\uD558\uC138\uC694."
  - "\uB2F9\uC2E0\uC740 \uD558\uB8E8\uB97C \uBC84\uD17C\uC2B5\uB2C8\uB2E4.\r\n\uAC74\uBB3C\uC744
    \uC870\uC0AC\uD558\uACE0, \uC880\uBE44\uB97C \uC7A1\uC544\uC11C \uACBD\uD5D8\uCE58\uB97C
    \uC5BB\uACE0, \uB808\uBCA8\uC774 \uC99D\uAC00\uD588\uAD70\uC694.\r\n\uB808\uBCA8\uC774
    \uC624\uB97C \uB54C\uB9C8\uB2E4 \uCCB4\uB825\uACFC \uCD5C\uB300 \uCCB4\uB825\uC774
    \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n5\uB808\uBCA8\uC774 \uB418\uBA74 \uCCB4\uB825
    \uB300\uC2E0 \uACF5\uACA9\uB825\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n\uD558\uC9C0\uB9CC
    \uC880\uBE44\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uB85C, \uD558\uB8E8\uAC00 \uC9C0\uB0A0
    \uB54C\uB9C8\uB2E4 \uB2A5\uB825\uCE58\uAC00 \uAC15\uD654\uB429\uB2C8\uB2E4."
  - "\uC774\uB7F0 \uB290\uB08C\uB300\uB85C \uD50C\uB808\uC774\uD558\uBA74 \uB429\uB2C8\uB2E4.\n7\uC77C\uCC28
    \uBC24\uC5D0 \uB4F1\uC7A5\uD558\uB294 \uBCF4\uC2A4\uB97C \uCC98\uCE58\uD558\uACE0,
    \uAC8C\uC784\uC5D0\uC11C \uC2B9\uB9AC\uD558\uC138\uC694.\r\n\uD29C\uD1A0\uB9AC\uC5BC\uC740
    \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
